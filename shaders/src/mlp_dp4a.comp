// Per-pixel MLP baseline using INT8 DP4A.
// Input: 5x5 luma + sub-pixel phase + scale = 28 features.
#version 450
#extension GL_EXT_integer_dot_product : require

layout(local_size_x = 8, local_size_y = 8) in;

layout(set = 0, binding = 0) uniform sampler2D source_tex;
layout(set = 0, binding = 1) uniform sampler2D base_tex;
layout(set = 0, binding = 2, rgba8) uniform image2D output_image;
layout(set = 0, binding = 3) buffer Weights {
    int weights[];
};

layout(push_constant) uniform PushConstants {
    vec4 src_bounds;
    vec2 center;
    float radius;
    float feather;
    float strength;
    uint flags;
    uint dst_width;
    uint dst_height;
    uvec2 ml_origin;
    uvec2 ml_size;
    uint hidden;
    float input_scale;
    float activation_limit;
    float output_scale;
    float residual_clamp;
    float scale;
} pc;

float perceptual_luma(vec2 uv) {
    vec3 color = sqrt(max(texture(source_tex, uv).rgb, vec3(0.0)));
    return dot(color, vec3(0.299, 0.587, 0.114));
}

float field_weight(vec2 uv) {
    float aspect = float(pc.dst_width) / float(pc.dst_height);
    vec2 delta = (uv - pc.center) * vec2(aspect, 1.0);
    float distance = length(delta);
    if (pc.feather <= 0.0) {
        return distance <= pc.radius ? 1.0 : 0.0;
    }
    return 1.0 - smoothstep(pc.radius, pc.radius + pc.feather, distance);
}

uint pack_lane(uint packed, uint lane, int value) {
    return packed | ((uint(value) & 0xffu) << (8u * lane));
}

void main() {
    uvec2 pixel = gl_GlobalInvocationID.xy + pc.ml_origin;
    if (pixel.x >= pc.ml_origin.x + pc.ml_size.x || pixel.y >= pc.ml_origin.y + pc.ml_size.y) {
        return;
    }

    vec2 uv = (vec2(pixel) + 0.5) / vec2(pc.dst_width, pc.dst_height);
    vec2 source_uv = mix(pc.src_bounds.xy, pc.src_bounds.zw, uv);
    vec4 base = texture(base_tex, uv);
    vec4 source = texture(source_tex, source_uv);

    if ((pc.flags & 1u) != 0u && source.a < 0.999) {
        imageStore(output_image, ivec2(pixel), base);
        return;
    }

    if ((pc.flags & 4u) == 0u || pc.hidden == 0u) {
        imageStore(output_image, ivec2(pixel), base);
        return;
    }

    vec2 size = vec2(textureSize(source_tex, 0));
    vec2 texel = vec2(
        sign(pc.src_bounds.z - pc.src_bounds.x),
        sign(pc.src_bounds.w - pc.src_bounds.y)
    ) / size;

    float features[28];
    int index = 0;
    for (int y = -2; y <= 2; y++) {
        for (int x = -2; x <= 2; x++) {
            features[index++] = perceptual_luma(source_uv + vec2(x, y) * texel);
        }
    }
    vec2 phase = fract(source_uv * size) - 0.5;
    features[25] = phase.x;
    features[26] = phase.y;
    features[27] = pc.scale;

    uint quantized[7];
    for (int i = 0; i < 7; i++) {
        quantized[i] = 0u;
    }
    for (int i = 0; i < 28; i++) {
        int value = int(clamp(round(features[i] * pc.input_scale), -127.0, 127.0));
        quantized[i / 4] = pack_lane(quantized[i / 4], uint(i % 4), value);
    }

    int hidden = int(pc.hidden);
    int groups1 = 7;
    uint hidden_packed[4] = uint[4](0u, 0u, 0u, 0u);

    for (int out_index = 0; out_index < hidden; out_index++) {
        int accumulator = 0;
        int weight_base = out_index * groups1;
        for (int group = 0; group < groups1; group++) {
            accumulator += dotPacked4x8EXT(weights[weight_base + group], int(quantized[group]));
        }
        accumulator += weights[hidden * groups1 + out_index];
        int activation = int(clamp(float(accumulator), -pc.activation_limit, pc.activation_limit));
        hidden_packed[out_index / 4] = pack_lane(
            hidden_packed[out_index / 4],
            uint(out_index % 4),
            activation
        );
    }

    int groups2 = hidden / 4;
    int layer2_base = hidden * groups1 + hidden;
    int output_accumulator = 0;
    for (int group = 0; group < groups2; group++) {
        output_accumulator += dotPacked4x8EXT(
            weights[layer2_base + group],
            int(hidden_packed[group])
        );
    }
    output_accumulator += weights[layer2_base + groups2];

    float residual = clamp(
        float(output_accumulator) * pc.output_scale,
        -pc.residual_clamp,
        pc.residual_clamp
    );
    residual *= pc.strength * field_weight(uv);

    vec3 color = clamp(base.rgb + residual, 0.0, 1.0);
    imageStore(output_image, ivec2(pixel), vec4(color, base.a));
}
