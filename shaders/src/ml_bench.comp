// DP4A side of the inner-loop microbenchmark: one 16-wide int8 dot per thread.
#version 450
#extension GL_EXT_integer_dot_product : require

layout(local_size_x = 64) in;
layout(set = 0, binding = 0) buffer InputA { int a[]; };
layout(set = 0, binding = 1) buffer InputB { int b[]; };
layout(set = 0, binding = 2) buffer Output { int result[]; };

void main() {
    uint index = gl_GlobalInvocationID.x;
    int accumulator = 0;
    for (int group = 0; group < 4; group++) {
        accumulator += dotPacked4x8EXT(a[index * 4 + group], b[index * 4 + group]);
    }
    result[index] = accumulator;
}
