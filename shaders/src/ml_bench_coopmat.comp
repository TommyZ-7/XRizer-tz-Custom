// Cooperative-matrix side: 16x16x16 int8 WMMA per subgroup.
#version 450
#extension GL_KHR_cooperative_matrix : require
#extension GL_KHR_memory_scope_semantics : require
#extension GL_EXT_shader_explicit_arithmetic_types_int8 : require
#extension GL_EXT_shader_explicit_arithmetic_types_int32 : require

layout(local_size_x = 32) in;
layout(set = 0, binding = 0) buffer InputA { int8_t a[]; };
layout(set = 0, binding = 1) buffer InputB { int8_t b[]; };
layout(set = 0, binding = 2) buffer Output { int result[]; };

void main() {
    coopmat<int8_t, gl_ScopeSubgroup, 16, 16, gl_MatrixUseA> matrix_a;
    coopmat<int8_t, gl_ScopeSubgroup, 16, 16, gl_MatrixUseB> matrix_b;
    coopmat<int32_t, gl_ScopeSubgroup, 16, 16, gl_MatrixUseAccumulator> matrix_c;
    coopMatLoad(matrix_a, a, 0, 16, gl_CooperativeMatrixLayoutRowMajor);
    coopMatLoad(matrix_b, b, 0, 16, gl_CooperativeMatrixLayoutRowMajor);
    coopMatLoad(matrix_c, result, 0, 16, gl_CooperativeMatrixLayoutRowMajor);
    matrix_c = coopMatMulAdd(matrix_a, matrix_b, matrix_c);
    coopMatStore(matrix_c, result, 0, 16, gl_CooperativeMatrixLayoutRowMajor);
}
